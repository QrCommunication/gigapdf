    "db:studio": "prisma studio",
    "postinstall": "prisma generate || true && node -e \"const{cpSync}=require('fs');cpSync(require.resolve('@qrcommunication/gigapdf-lib/gigapdf.wasm'),'public/gigapdf.wasm');\""
