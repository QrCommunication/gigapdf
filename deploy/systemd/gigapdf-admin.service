[Unit]
Description=GigaPDF Next.js Admin Panel
After=network.target

[Service]
Type=simple
User=ploi
Group=ploi
WorkingDirectory=/home/ploi/giga-pdf.com/apps/admin
Environment="NODE_ENV=production"
Environment="PORT=3001"
EnvironmentFile=/home/ploi/giga-pdf.com/.env
ExecStart=/usr/bin/node /home/ploi/giga-pdf.com/apps/admin/.next/standalone/apps/admin/server.js
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=300
StandardOutput=append:/var/log/gigapdf/admin.log
StandardError=append:/var/log/gigapdf/admin-error.log

# Memory limits to prevent VPS OOM
MemoryHigh=1536M
MemoryMax=2G

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/ploi/giga-pdf.com /var/log/gigapdf

[Install]
WantedBy=multi-user.target
