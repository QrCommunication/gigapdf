[Unit]
Description=GigaPDF FastAPI Backend
After=network.target

[Service]
Type=simple
User=ploi
Group=ploi
WorkingDirectory=/home/ploi/giga-pdf.com
Environment="PATH=/home/ploi/giga-pdf.com/.venv/bin"
EnvironmentFile=/home/ploi/giga-pdf.com/.env
ExecStart=/home/ploi/giga-pdf.com/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=300
StandardOutput=append:/var/log/gigapdf/api.log
StandardError=append:/var/log/gigapdf/api-error.log

# Memory limits to prevent VPS OOM
MemoryHigh=1536M
MemoryMax=2G

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/ploi/giga-pdf.com /var/lib/gigapdf /var/log/gigapdf

[Install]
WantedBy=multi-user.target
