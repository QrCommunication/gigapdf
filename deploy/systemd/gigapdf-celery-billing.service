[Unit]
Description=GigaPDF Celery Billing Worker
After=network.target

[Service]
Type=simple
User=ploi
Group=ploi
WorkingDirectory=/home/ploi/giga-pdf.com
Environment="PATH=/home/ploi/giga-pdf.com/.venv/bin"
EnvironmentFile=/home/ploi/giga-pdf.com/.env
ExecStart=/home/ploi/giga-pdf.com/.venv/bin/celery -A app.tasks.celery_app worker --loglevel=info --queues=billing --concurrency=2
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300
StandardOutput=append:/var/log/gigapdf/celery-billing.log
StandardError=append:/var/log/gigapdf/celery-billing-error.log

# Memory limits to prevent VPS OOM (async workers need less than web/api)
MemoryHigh=768M
MemoryMax=1G

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/ploi/giga-pdf.com /var/lib/gigapdf /var/log/gigapdf

[Install]
WantedBy=multi-user.target
