# Object storage — any S3-compatible provider
# STORAGE_PROVIDER: idrive | scaleway | aws | minio | s3
STORAGE_PROVIDER=idrive
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=your_bucket_name
# Required for idrive/minio/s3 (iDrive e2: endpoint shown in the e2 console)
S3_ENDPOINT=https://xxxx.par.idrivee2-NN.com
# Optional — provider default when empty (scaleway: fr-par)
S3_REGION=
# Encryption at rest: enable default encryption on the bucket (provider console)
